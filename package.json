{
  "name": "docb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:generators": "tsx ./internals/testing/test-generators.ts",
    "checkTs": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "generate": "cross-env \"NODE_OPTIONS=--import tsx\" plop --plopfile internals/generators/plopfile.ts",
    "prettify": "prettier --write",
    "extract-messages": "i18next-scanner --config=internals/extractMessages/i18next-scanner.config.js",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@reduxjs/toolkit": "2.13.0",
    "bootstrap": "5.3.8",
    "crypto-js": "4.2.0",
    "dexie": "4.4.7",
    "i18next": "26.5.11",
    "i18next-browser-languagedetector": "8.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-helmet-async": "3.0.0",
    "react-i18next": "17.1.9",
    "react-redux": "9.3.0",
    "react-router": "8.5.0",
    "redux-injectors": "2.1.0",
    "redux-saga": "1.5.1",
    "sanitize.css": "13.0.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/shelljs": "0.10.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "chalk": "6.0.1",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "i18next-scanner": "4.6.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "node-plop": "0.32.3",
    "plop": "4.0.5",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "shelljs": "0.10.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.5"
  }
}
